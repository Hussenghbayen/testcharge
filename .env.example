# انسخ هذا الملف باسم .env واملأ القيم الحقيقية محلياً.
# .env غير مرفوع على GitHub (مضاف إلى .gitignore) — لا تضع فيه أسراراً وترفعه بالخطأ.

# رابط الـ backend الأساسي (بدون / في النهاية)
API_BASE_URL=https://charging-api-tkne.onrender.com/api

# مفتاح Firebase Web API (يُستخدم من الواجهة فقط، وهو مفتاح عام وليس سرّاً
# حسب توثيق Firebase، لكن يوضع هنا بدل تثبيته داخل الكود مباشرة)
FIREBASE_WEB_API_KEY=REPLACE_WITH_YOUR_FIREBASE_WEB_API_KEY
